{
  "manifest_version": 3,
  "minimum_chrome_version": "140",
  "name": "Xtags",
  "version": "0.1.9",
  "description": "__MSG_extensionDescription__",
  "author": "yishan",
  "homepage_url": "https://manifoldor.github.io/xtags/",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.typesafe.ai/*"
  ],
  "icons": {
    "16": "icons/on/icon16.png",
    "32": "icons/on/icon32.png",
    "48": "icons/on/icon48.png",
    "128": "icons/on/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Xtags",
    "default_icon": {
      "16": "icons/on/icon16.png",
      "32": "icons/on/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["fulltext.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "service.js",
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "default_locale": "en",
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
